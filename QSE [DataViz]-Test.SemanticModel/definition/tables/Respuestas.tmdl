	measure '% Apostol' = ```
			
			VAR __BASELINE_VALUE =
				CALCULATE(
					DISTINCTCOUNT(Respuestas[Id Paciente]),  
			        'Respuestas'[Clas NPS] = "Apostol", 
			        Respuestas[Id Pregunta] IN {"374", "386"}
				)
			VAR __MEASURE_VALUE = 
			    CALCULATE(
				    DISTINCTCOUNT(Respuestas[Id Paciente]),
				    ALLSELECTED('Respuestas'[Respuesta]),
			        Respuestas[Id Pregunta] IN {"374", "386"},
			        Respuestas[Respuesta] <> "0"
			    )
			RETURN
				IF(
					NOT ISBLANK(__MEASURE_VALUE),
					DIVIDE(__BASELINE_VALUE, __MEASURE_VALUE)
				)
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Medidas
		lineageTag: 0db232c3-6fcb-4348-9eca-cf9f7216c1f8

