	measure FCR = ```
			
			VAR __BASELINE_VALUE =
				CALCULATE(
					COUNT('Respuestas'[Flag FCR]),  
			        'Respuestas'[Flag FCR] IN {"SI"}, 
			        Respuestas[Id Pregunta] IN {"373", "385"},
			        Respuestas[Respuesta] <> "0"
				)
			VAR __MEASURE_VALUE = 
			    CALCULATE(
				    COUNTROWS(Respuestas), 
			        Respuestas[Id Pregunta] IN {"373", "385"},
			        Respuestas[Respuesta] <> "0"
				   
			    )
			
			VAR _Resultado =IF(
					NOT ISBLANK(__MEASURE_VALUE),
					DIVIDE(__BASELINE_VALUE, __MEASURE_VALUE)
				)
			RETURN
			IF (ISBLANK(_Resultado), 0, _Resultado)
			```
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: Medidas
		lineageTag: 4d22a5fc-7b8b-46ca-8477-09c3d84bde46

