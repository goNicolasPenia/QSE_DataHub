	measure 'Cant Encuestas Env' = ```
			
			VAR T =    
			    CALCULATE(
			        TOTALMTD(
			            DISTINCTCOUNT(Respuestas[Id Paciente])
			            ,Calendario[Fecha])
			            ,Respuestas[Id Pregunta] = "345" || Respuestas[Id Pregunta] = "383"
			    )
			
			RETURN
			    IF (
			        ISBLANK(T),
			        0, T
			    )
			```
		formatString: 0
		displayFolder: Medidas
		lineageTag: 66d93eed-f2c7-4243-a397-fb5f6df740c6

		changedProperty = FormatString

	measure 'Cantidad dias' = ```
			
			VAR T =
			    IF (
			        AVERAGE(Calendario[Dias Laborados]) < 1,
			            DISTINCTCOUNT(Respuestas[Fecha Registro]),
			        AVERAGE(Calendario[Dias Laborados])
			    )  
			RETURN
			    IF (
			        ISBLANK(T),
			        0, T
			    )
			```
		formatString: 0
		displayFolder: Medidas
		lineageTag: 5e2924f5-c598-4887-a5ad-f57c8a9e636e

	measure '% Resp 5' = ```
			
