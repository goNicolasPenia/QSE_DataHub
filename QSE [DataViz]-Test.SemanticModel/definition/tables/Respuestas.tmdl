				CALCULATE(
					COUNT('Respuestas'[Respuesta en Numero]),  'Respuestas'[Respuesta] = "5"
				)
			VAR __MEASURE_VALUE = 
			    CALCULATE(
				    COUNTA('Respuestas'[Respuesta en Numero]),
				    ALLSELECTED('Respuestas'[Respuesta])
			    )
			RETURN
				IF(
					NOT ISBLANK(__MEASURE_VALUE),
					DIVIDE(__BASELINE_VALUE, __MEASURE_VALUE)
				)
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
