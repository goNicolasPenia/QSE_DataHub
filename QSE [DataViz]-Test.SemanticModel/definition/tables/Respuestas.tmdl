	column 'Respuesta en Numero' = ```
			
			    IF(
			        Respuestas[Respuesta] = "0" ,CONVERT(Respuestas[Respuesta],INTEGER),
			    IF(
			        Respuestas[Respuesta] = "1" ,CONVERT(Respuestas[Respuesta],INTEGER),
			    IF(
			        Respuestas[Respuesta] = "2" ,CONVERT(Respuestas[Respuesta],INTEGER),
			    IF(
			        Respuestas[Respuesta] = "3" ,CONVERT(Respuestas[Respuesta],INTEGER),
			    IF(
			        Respuestas[Respuesta] = "4" ,CONVERT(Respuestas[Respuesta],INTEGER),
			    IF(
			        Respuestas[Respuesta] = "5" ,CONVERT(Respuestas[Respuesta],INTEGER),
			    IF(
			        Respuestas[Respuesta] = "6" ,CONVERT(Respuestas[Respuesta],INTEGER),
			    IF(
			        Respuestas[Respuesta] = "7" ,CONVERT(Respuestas[Respuesta],INTEGER),
			    IF(
			        Respuestas[Respuesta] = "8" ,CONVERT(Respuestas[Respuesta],INTEGER),
			    IF(
			        Respuestas[Respuesta] = "9" ,CONVERT(Respuestas[Respuesta],INTEGER),
			    IF(
			        Respuestas[Respuesta] = "10" ,CONVERT(Respuestas[Respuesta],INTEGER),
			    BLANK()
			    )))))))))))
			```
		formatString: 0
		displayFolder: Medidas
		lineageTag: 25dda2e9-0b0e-4937-a423-57c5e6fd21e9
		summarizeBy: sum

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Clas NPS' = ```
			
			    IF(
			        Respuestas[Respuesta] = "0" ,"N/A",
			    IF(
			        Respuestas[Respuesta] = "10" ,"Apostol",
			    IF(
			        Respuestas[Respuesta] = "9" ,"Apostol",
			    IF(
			        Respuestas[Respuesta] = "8" ,"Neutral",
			    IF(
			        Respuestas[Respuesta] = "7" ,"Neutral",
			    "Detractor")))))
			```
		displayFolder: Medidas
		lineageTag: 8d5760a9-bee3-465e-86c5-2853ca56eba1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Flag FCR' = ```
			
			IF(
			    Respuestas[Id Pregunta]="373" && CONTAINSSTRING(Respuestas[Respuesta],"SI") 
			        ,"SI"
			    ,IF ( 
			        Respuestas[Id Pregunta]="385" && CONTAINSSTRING(Respuestas[Respuesta],"1") 
			        ,"SI"
			    ,IF ( 
			        Respuestas[Id Pregunta]="385" && CONTAINSSTRING(Respuestas[Respuesta],"SI") 
			        ,"SI"
			        ,"NO"
			    )
			)
			)
			```
		displayFolder: Medidas
		lineageTag: 46f892c0-5f90-4445-85a2-026e00eb363d
		summarizeBy: none

